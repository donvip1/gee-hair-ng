# Canonical public site URL (use the custom domain when available)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional Google Search Console verification value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Public URL returned after deploying the Google Apps Script web app
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Must match the SHARED_SECRET Script Property in Apps Script
APPS_SCRIPT_SHARED_SECRET=replace-with-a-long-random-secret

# Private admin access (set only in Vercel, never commit the real value)
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-different-long-random-secret
